#!/usr/bin/env bash
# Generated by BMCShell-Install. Configuration values are quoted as data.
# Parse the complete installer before running it or replacing pipeline stdin.
# This keeps prompts and child installers from consuming downloaded shell code.
{
if [[ -n ${BASH_SOURCE[0]-} && ${BASH_SOURCE[0]} != "$0" ]]; then
    printf '请使用 bash %q 运行安装器。\n' "${BASH_SOURCE[0]}" >&2
    return 2
fi
if (( BASH_VERSINFO[0] < 4 )); then
    printf '安装器需要 Bash 4 或更新版本。\n' >&2
    exit 2
fi
case ${1-} in
    -h|--help)
        printf '说明\n  交互式安装 BMCShell，并应用配置中的全局参数、扩展和附加脚本。\n\n'
        printf '用法\n  bash %q [-h|--help]\n  curl -fsSL <安装脚本的 HTTPS 地址> | bash\n\n' "${BASH_SOURCE[0]:-install-bmcshell.sh}"
        printf '参数\n  -h, --help  显示帮助并退出。\n\n示例\n  bash ./install-bmcshell.sh\n\n'
        printf '使用说明\n  安装需要交互式 Bash 4 或更新版本。本地资源路径相对于安装脚本所在目录。\n'
        exit 0 ;;
    '') ;;
    *) printf '不支持的参数 %q。请使用 --help 查看用法。\n' "$1" >&2; exit 2 ;;
esac
if (( $# > 1 )); then
    printf '安装器不接受额外参数。请使用 --help 查看用法。\n' >&2
    exit 2
fi
if [[ ! -t 0 ]]; then
    if ! { : </dev/tty; } 2>/dev/null; then
        printf '安装器需要交互式终端，请在终端中运行 curl ... | bash 或 bash install-bmcshell.sh。\n' >&2
        exit 2
    fi
    exec </dev/tty
fi
if [[ ! -t 0 ]]; then
    printf '无法打开交互式终端。\n' >&2
    exit 2
fi
set -o pipefail
umask 077

{{.Payload}}

die() { printf '\n安装中止：%s\n' "$*" >&2; exit 1; }
notice() { printf '\n%s\n' "$*"; }
WARNINGS=0
SCAN_BASE_PATH=$PATH
warn() { printf '提示：%s\n' "$*" >&2; WARNINGS=$((WARNINGS + 1)); }
if [[ -n ${BASH_SOURCE[0]-} ]]; then
    SCRIPT_DIR=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 1
else
    # Online installers use HTTPS resources; relative local paths use the caller's directory.
    SCRIPT_DIR=$(pwd -P) || exit 1
fi
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bmcshell-install.XXXXXXXX") || die '无法创建临时目录。'
cleanup() { [[ -z ${WORK_DIR-} || ! -d $WORK_DIR ]] || rm -rf -- "$WORK_DIR"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

ask() {
    printf '%s' "$1"
    IFS= read -r REPLY || die '输入已结束。'
    REPLY=${REPLY%$'\r'}
}
confirm() {
    local message=$1 default=${2:-0} suffix
    if [[ $default == 1 ]]; then suffix=' [Y/n] '; else suffix=' [y/N] '; fi
    while :; do
        ask "$message$suffix"
        case $REPLY in
            '') [[ $default == 1 ]]; return ;;
            y|Y|yes|YES) return 0 ;;
            n|N|no|NO) return 1 ;;
            *) printf '请输入 y 或 n。\n' ;;
        esac
    done
}
expand_path() {
    local value=$1
    case $value in
        '~') value=$HOME ;;
        '~/'*) value=$HOME/${value:2} ;;
        '$HOME') value=$HOME ;;
        '$HOME/'*) value=$HOME/${value:6} ;;
        '${HOME}') value=$HOME ;;
        '${HOME}/'*) value=$HOME/${value:8} ;;
    esac
    if [[ $value =~ ^[A-Za-z]:[\\/] ]]; then
        command -v cygpath >/dev/null 2>&1 || { printf 'Windows 路径需要 cygpath：%s\n' "$value" >&2; return 1; }
        value=$(cygpath -u -- "$value") || return
    fi
    [[ $value == /* ]] || value=$SCRIPT_DIR/$value
    printf '%s\n' "$value"
}
choose_path() {
    local label=$1 fallback=$2 candidate
    ask "$label [$fallback]："
    candidate=${REPLY:-$fallback}
    [[ -n $candidate && $candidate != *$'\n'* && $candidate != *$'\r'* ]] || die '目录不能为空或包含换行。'
    CHOSEN_PATH=$(expand_path "$candidate") || die '目录格式无效。'
}
verify_sha() {
    local file=$1 expected=$2 actual
    [[ -n $expected ]] || return 0
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum -- "$file") || return
        actual=${actual%% *}
    elif command -v shasum >/dev/null 2>&1; then
        actual=$(shasum -a 256 -- "$file") || return
        actual=${actual%% *}
    elif command -v openssl >/dev/null 2>&1; then
        actual=$(openssl dgst -sha256 "$file") || return
        actual=${actual##* }
    else
        printf 'SHA256 校验需要 sha256sum、shasum 或 openssl。\n' >&2
        return 1
    fi
    if [[ ${actual,,} != ${expected,,} ]]; then
        printf 'SHA256 校验失败：%s\n' "$file" >&2
        return 1
    fi
}
download_https() {
    local source=$1 path=$2 status system_dir windows_curl
    shift 2
    local -a options=(--fail --location --proto '=https' --proto-redir '=https' "$@")
    if curl "${options[@]}" --output "$path" "$source"; then
        return 0
    else
        status=$?
    fi
    [[ $status == 77 ]] && command -v cygpath >/dev/null 2>&1 || return "$status"
    system_dir=$(cygpath -u -S) || return "$status"
    windows_curl=$system_dir/curl.exe
    [[ -x $windows_curl ]] || return "$status"

    printf '当前 curl 无法读取 CA 证书文件，改用 Windows curl 和系统证书库。\n' >&2
    (
        unset CURL_CA_BUNDLE SSL_CERT_FILE SSL_CERT_DIR
        # Redirect in Bash so the native executable does not need a POSIX path.
        "$windows_curl" --disable "${options[@]}" "$source" > "$path"
    )
}
FETCH_COUNT=0
fetch_file() {
    local source=$1 digest=$2 allow_directory=${3:-0} path
    if [[ $source == https://* ]]; then
        command -v curl >/dev/null 2>&1 || { printf '下载需要 curl。\n' >&2; return 1; }
        FETCH_COUNT=$((FETCH_COUNT + 1))
        # Package loading identifies ZIP files by extension; Bash can also execute
        # downloaded script text from this temporary filename.
        path=$WORK_DIR/download-$FETCH_COUNT.zip
        printf '下载：%s\n' "$source"
        download_https "$source" "$path" || return
    else
        path=$(expand_path "$source") || return
        if [[ $allow_directory == 1 && -d $path && -z $digest ]]; then
            FETCHED_FILE=$path
            return 0
        fi
    fi
    [[ -f $path ]] || { printf '文件不存在：%s\n' "$path" >&2; return 1; }
    verify_sha "$path" "$digest" || return
    FETCHED_FILE=$path
}
resolve_core_release() {
    local index_file=$WORK_DIR/release-index.json system_dir powershell native_index selection
    local -a fields
    system_dir=$(cygpath -u -S) || return 1
    powershell=$system_dir/WindowsPowerShell/v1.0/powershell.exe
    [[ -x $powershell ]] || { printf '读取框架版本索引需要 Windows PowerShell。\n' >&2; return 1; }
    native_index=$(cygpath -aw -- "$index_file") || return 1

    printf '读取框架版本索引：%s\n' "$CORE_RELEASE_INDEX"
    download_https "$CORE_RELEASE_INDEX" "$index_file" --max-filesize 1048576 || return
    selection=$(BMCI_INDEX_PATH="$native_index" BMCI_INDEX_VERSION="$CORE_VERSION" MSYS2_ARG_CONV_EXCL='*' \
        "$powershell" -NoProfile -NonInteractive -Command {{.ReleaseIndexParser}}) || return
    mapfile -t fields <<< "${selection//$'\r'/}"
    if [[ ${#fields[@]} != 3 || -z ${fields[0]} || -z ${fields[1]} || -z ${fields[2]} ]]; then
        printf '框架版本索引没有返回完整的发布信息。\n' >&2
        return 1
    fi
    CORE_VERSION=${fields[0]}
    CORE_ARCHIVE=${fields[1]}
    CORE_SHA256=${fields[2]}
    printf '选定框架版本：%s\n' "$CORE_VERSION"
}
ensure_core_executable() {
    local bin=$1/bin release=$1/bin/releases/$CORE_VERSION executable active trailing
    executable=$release/BMCShell.exe
    if [[ -L $bin || -L $bin/active || ! -f $bin/active ]] ||
        ! { IFS= read -r -n 130 active && ! IFS= read -r -n 1 trailing; } < "$bin/active"; then
        printf '框架活动版本文件缺失或无效。\n' >&2
        return 1
    fi
    if [[ $active != "$CORE_VERSION" ]]; then
        printf '框架活动版本与所选版本 %s 不一致。\n' "$CORE_VERSION" >&2
        return 1
    fi
    if [[ -L $bin/releases || -L $release || -L $executable || ! -f $executable || ! -s $executable ]]; then
        printf '框架程序文件缺失或无效：%s\n' "$executable" >&2
        return 1
    fi
    if [[ ! -x $executable ]]; then
        if ! chmod u+x -- "$executable" || [[ ! -x $executable ]]; then
            printf '无法为框架程序设置执行权限：%s\n' "$executable" >&2
            return 1
        fi
        printf '已补齐 BMCShell.exe 的执行权限。\n'
    fi
}
prepare_core() {
    local entry listing permissions staged
    command -v unzip >/dev/null 2>&1 || { printf '解压框架需要 unzip。\n' >&2; return 1; }
    fetch_file "$CORE_ARCHIVE" "$CORE_SHA256" || return
    listing=$(unzip -Z1 "$FETCHED_FILE") || return
    [[ -n $listing ]] || { printf '框架 ZIP 为空。\n' >&2; return 1; }
    while IFS= read -r entry; do
        case $entry in
            BMCShell|BMCShell/|BMCShell/*) ;;
            *) printf '框架 ZIP 包含非预期路径：%s\n' "$entry" >&2; return 1 ;;
        esac
        case /$entry/ in
            *'/../'*|*'/./'*|*\\*|*$'\r'*) printf '框架 ZIP 包含无效路径。\n' >&2; return 1 ;;
        esac
    done <<< "$listing"
    permissions=$(unzip -Z -l "$FETCHED_FILE") || return
    while IFS= read -r entry; do
        [[ $entry != l* ]] || { printf '框架 ZIP 不允许符号链接。\n' >&2; return 1; }
    done <<< "$permissions"
    staged=$(mktemp -d "$WORK_DIR/core.XXXXXXXX") || return
    unzip -q -o "$FETCHED_FILE" -d "$staged" || return
    [[ -s $staged/BMCShell/bin/bmcshell.sh && -s $staged/BMCShell/bin/releases/$CORE_VERSION/shell/bmcshell.sh ]] || {
        printf '框架 ZIP 缺少便携安装入口。\n' >&2; return 1;
    }
    ensure_core_executable "$staged/BMCShell" || return
    STAGED_CORE=$staged/BMCShell
}
retry_or_abort() {
    local label=$1 required=$2
    while :; do
        if [[ $required == 1 ]]; then
            ask "$label 失败：[r]重试 / [a]取消："
        else
            ask "$label 失败：[r]重试 / [s]跳过 / [a]取消："
        fi
        case $REPLY in
            r|R) return 0 ;;
            s|S) if [[ $required == 0 ]]; then warn "已跳过：$label"; return 1; fi ;;
            a|A|'') die "$label 未完成。" ;;
        esac
    done
}
install_core() {
    local contents parent version
    notice '[1/5] 安装 BMCShell 框架'
    if [[ -n $CORE_RELEASE_INDEX ]]; then
        while ! resolve_core_release; do retry_or_abort '读取框架版本索引' 1; done
    fi
    choose_path '框架安装目录' "$INSTALL_DIR_DEFAULT"
    INSTALL_DIR=$CHOSEN_PATH
    if [[ -e $INSTALL_DIR && ! -d $INSTALL_DIR ]]; then die '安装位置不是目录。'; fi
    contents=$(shopt -s nullglob dotglob; printf '%s' "$INSTALL_DIR"/*)
    if [[ -d $INSTALL_DIR && -n $contents ]]; then
        [[ -s $INSTALL_DIR/bin/bmcshell.sh ]] || die '目标目录非空且不是 BMCShell 便携安装，请选择空目录。'
        confirm '此目录已有 BMCShell，使用已有框架继续？' 0 || die '未选择已有框架。'
        INSTALL_DIR=$(cd -P -- "$INSTALL_DIR" && pwd -P) || die '无法访问安装目录。'
        ensure_core_executable "$INSTALL_DIR" || die '已有框架未通过启动检查。'
    else
        confirm "确认安装框架 $CORE_VERSION 到 $INSTALL_DIR？" 1 || die '已取消框架安装。'
        while ! prepare_core; do retry_or_abort '准备框架发布包' 1; done
        parent=${INSTALL_DIR%/*}
        mkdir -p -- "$parent" || die '无法创建安装目录的父目录。'
        if [[ -d $INSTALL_DIR ]]; then
            rmdir -- "$INSTALL_DIR" || die '目标目录在安装期间发生变化。'
        fi
        # mv -T refuses an existing destination directory; never merge with user data.
        mv -n -T -- "$STAGED_CORE" "$INSTALL_DIR" || die '无法发布框架，请检查目录权限和目标位置。'
        [[ ! -e $STAGED_CORE ]] || die '目标目录在安装期间发生变化，未覆盖已有内容。'
        INSTALL_DIR=$(cd -P -- "$INSTALL_DIR" && pwd -P) || die '无法访问安装目录。'
    fi
    if [[ -n $DATA_HOME_DEFAULT ]]; then
        choose_path 'BMCShell 数据目录' "$DATA_HOME_DEFAULT"
        DATA_HOME=$CHOSEN_PATH
    else
        choose_path 'BMCShell 数据目录' "$INSTALL_DIR"
        DATA_HOME=$CHOSEN_PATH
    fi
    mkdir -p -- "$DATA_HOME" || die '无法创建数据目录。'
    DATA_HOME=$(cd -P -- "$DATA_HOME" && pwd -P) || die '无法访问数据目录。'
    BMCSHELL_HOME=$DATA_HOME
    if command -v cygpath >/dev/null 2>&1; then
        BMCSHELL_HOME=$(cygpath -aw -- "$DATA_HOME") || die '无法转换数据目录。'
    fi
    export BMCSHELL_HOME
    unset BMCSHELL_EXE
    source "$INSTALL_DIR/bin/bmcshell.sh" || die '框架入口加载失败。'
    version=$(bmc version) || die '框架版本检查失败。'
    version=${version%$'\r'}
    [[ $version == "BMCShell $CORE_VERSION" ]] || die "框架版本不一致：期望 BMCShell $CORE_VERSION，实际 $version"
    STATE_DIR=$INSTALL_DIR/.bmcshell-install
    [[ ! -L $STATE_DIR ]] || die '安装器状态目录不能是符号链接。'
    mkdir -p -- "$STATE_DIR" || die '无法创建安装器状态目录。'
}

declare -a FOUND_DIRS=() ENV_KEYS=() ENV_VALUES=()
add_path_dir() {
    local directory=$1 current
    [[ -d $directory ]] || return 0
    directory=$(cd -P -- "$directory" && pwd -P) || return
    for current in "${FOUND_DIRS[@]}"; do [[ $current != "$directory" ]] || return 0; done
    FOUND_DIRS+=("$directory")
    case :$PATH: in *:"$directory":*) ;; *) PATH=$directory:$PATH; export PATH ;; esac
}
scan_tools() {
    local name located directory expanded pattern
    local -a candidates=() defaults=(
        /usr/local/bin /usr/bin /bin /ucrt64/bin /mingw64/bin
        /c/Environment/Git/usr/bin /c/Environment/msys64/usr/bin
        /c/Environment/msys64/ucrt64/bin /c/Program\ Files/Git/usr/bin
        /drives/c/Environment/Git/usr/bin /drives/c/Environment/msys64/usr/bin
        /drives/c/Environment/msys64/ucrt64/bin
    )
    [[ $SCAN_ENABLED == 1 ]] || return 0
    while :; do
        ask '附加工具目录（可选，回车跳过）：'
        [[ -n $REPLY ]] || break
        directory=$(expand_path "$REPLY") || continue
        if [[ -d $directory ]]; then
            SCAN_DIRECTORIES+=("$directory")
            break
        fi
        printf '目录不存在，请重新输入。\n'
    done
    PATH=$SCAN_BASE_PATH
    export PATH
    FOUND_DIRS=()
    notice '扫描外部工具路径…'
    candidates=("${SCAN_DIRECTORIES[@]}" "${defaults[@]}")
    for name in "${SCAN_COMMANDS[@]}"; do
        located=$(type -P -- "$name" 2>/dev/null) || located=''
        if [[ -n $located ]]; then
            [[ $located == */* ]] && add_path_dir "${located%/*}"
            printf '  %s：%s\n' "$name" "$located"
            continue
        fi
        for pattern in "${candidates[@]}"; do
            expanded=$(expand_path "$pattern") || continue
            while IFS= read -r directory; do
                [[ -d $directory ]] || continue
                if [[ -f $directory/$name && -x $directory/$name || -f $directory/$name.exe && -x $directory/$name.exe ]]; then
                    add_path_dir "$directory" || die '无法应用工具路径。'
                    located=$(type -P -- "$name" 2>/dev/null) || located=''
                    [[ -n $located ]] && break
                fi
            done < <(compgen -G "$expanded")
            [[ -z $located ]] || break
        done
        if [[ -n $located ]]; then printf '  %s：%s\n' "$name" "$located"
        else printf '  %s：未找到\n' "$name"; fi
    done
    hash -r
    if (( ${#FOUND_DIRS[@]} )) && ! confirm '使用并保存以上扫描到的工具目录？' 1; then
        PATH=$SCAN_BASE_PATH
        export PATH
        FOUND_DIRS=()
        hash -r
        printf '已保留扫描前的 PATH。\n'
    fi
}
apply_env() {
    local key=$1 value=$2
    ask "环境参数 $key [$value]（回车保留）："
    [[ -z $REPLY ]] || value=$REPLY
    printf -v "$key" '%s' "$value" || die "无法设置环境参数 $key。"
    export "$key" || die "无法导出环境参数 $key。"
    ENV_KEYS+=("$key") ENV_VALUES+=("$value")
}
apply_setting() {
    local key=$1 value=$2
    ask "框架设置 $key [$value]（回车保留）："
    [[ -z $REPLY ]] || value=$REPLY
    while ! bmc setting --set "$key" "$value"; do
        retry_or_abort "设置 $key" 1
        ask "请输入 $key 的新值 [$value]："
        [[ -z $REPLY ]] || value=$REPLY
    done
}
apply_plugin_source() {
    local name=$1 url=$2
    shift 2
    while ! bmc setting --set "plugin.source.$name" "$url" "$@" >/dev/null; do
        retry_or_abort "设置插件源 $name" 1
    done
    printf '已设置插件源：%s\n' "$name"
}
write_loaders() {
    local env_temp load_temp directory index
    env_temp=$(mktemp "$STATE_DIR/.env.XXXXXXXX") || die '无法创建环境文件。'
    load_temp=$(mktemp "$STATE_DIR/.load.XXXXXXXX") || die '无法创建加载文件。'
    {
        printf '# Generated by BMCShell-Install.\n'
        for directory in "${FOUND_DIRS[@]}"; do
            printf 'case :${PATH-}: in *:%q:*) ;; *) export PATH=%q:${PATH-} ;; esac\n' "$directory" "$directory"
        done
        for index in "${!ENV_KEYS[@]}"; do
            printf 'export %s=%q\n' "${ENV_KEYS[index]}" "${ENV_VALUES[index]}"
        done
    } > "$env_temp" || die '环境文件写入失败。'
    {
        printf '# Source this file in Bash.\n'
        printf 'export BMCSHELL_HOME=%q\n' "$BMCSHELL_HOME"
        printf 'source %q || return\n' "$STATE_DIR/env.sh"
        printf 'source %q\n' "$INSTALL_DIR/bin/bmcshell.sh"
    } > "$load_temp" || die '加载文件写入失败。'
    mv -f -- "$env_temp" "$STATE_DIR/env.sh" || die '保存环境文件失败。'
    mv -f -- "$load_temp" "$STATE_DIR/load.sh" || die '保存加载文件失败。'
    LOAD_FILE=$STATE_DIR/load.sh
}
configure_autoload() {
    local bashrc=$HOME/.bashrc marker='# BMCShell-Install: ' line expected exists=0
    [[ $AUTOLOAD == 1 ]] || return 0
    confirm '将此安装加入 ~/.bashrc，使新 Bash 终端自动加载？' 1 || return 0
    printf -v expected 'source %q # BMCShell-Install: %q' "$LOAD_FILE" "$INSTALL_DIR"
    if [[ -e $bashrc && ! -f $bashrc ]]; then die '~/.bashrc 不是普通文件。'; fi
    if [[ -f $bashrc ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            [[ $line != "$expected" ]] || exists=1
        done < "$bashrc"
    fi
    if [[ $exists == 0 ]]; then
        printf '\n%s\n' "$expected" >> "$bashrc" || die '无法更新 ~/.bashrc。'
    fi
    printf '自动加载已配置：%s\n' "$bashrc"
}
configure_globals() {
    notice '[2/5] 扫描并设置全局参数'
    scan_tools
    config_environment
    config_settings
    bmc setting --check || die '框架设置检查失败。'
    write_loaders
    configure_autoload
}
check_required() {
    local name missing=0
    for name in "${REQUIRED_COMMANDS[@]}"; do
        if ! type -P -- "$name" >/dev/null 2>&1; then
            printf '必需工具未找到：%s\n' "$name" >&2
            missing=1
        fi
    done
    return "$missing"
}
doctor_check() {
    local report choice
    while :; do
        bmc doctor -d || { retry_or_abort '框架依赖诊断' 1; continue; }
        report=$(bmc doctor -f missing) || { retry_or_abort '查询缺失依赖' 1; continue; }
        report=${report//$'\r'/}
        if check_required && [[ -z $report ]]; then return 0; fi
        if [[ $DOCTOR_AUTO_REPAIR == 1 ]] && confirm '调用框架的交互式依赖修复？' 0; then
            bmc doctor -a -d || warn '依赖自动修复没有全部完成。'
        fi
        while :; do
            if check_required; then
                ask '依赖尚未就绪：[r]重新检查 / [c]继续并记录提示 / [a]取消：'
            else
                ask '必需工具尚未就绪：[r]重新检查 / [a]取消：'
            fi
            case $REPLY in
                r|R) scan_tools; break ;;
                c|C)
                    if check_required; then warn '用户选择在依赖未全部就绪时继续。'; return 0; fi ;;
                a|A|'') die '依赖检查未通过。' ;;
            esac
        done
    done
}
CATALOG_READY=0
install_package() {
    local name=$1 file=$2 sha=$3 selector=$4 required=$5 default=$6 success
    if ! confirm "安装扩展：$name？" "$default"; then
        [[ $required == 0 ]] || die "必需扩展 $name 被取消。"
        warn "已跳过扩展：$name"
        return 0
    fi
    while :; do
        success=0
        if [[ -n $file ]]; then
            if fetch_file "$file" "$sha" 1 && bmc plugin install --file "$FETCHED_FILE"; then success=1; fi
        else
            if [[ $CATALOG_READY == 0 ]]; then
                if bmc plugin update; then CATALOG_READY=1; fi
            fi
            if [[ $CATALOG_READY == 1 ]] && bmc plugin install "$selector"; then success=1; fi
        fi
        [[ $success == 0 ]] || return 0
        retry_or_abort "安装扩展 $name" "$required" || return 0
    done
}
install_script() {
    local name=$1 file=$2 sha=$3 required=$4 default=$5
    shift 5
    if ! confirm "运行附加安装脚本：$name？" "$default"; then
        [[ $required == 0 ]] || die "必需安装脚本 $name 被取消。"
        warn "已跳过附加脚本：$name"
        return 0
    fi
    while :; do
        if fetch_file "$file" "$sha" && "$BASH" "$FETCHED_FILE" "$@"; then return 0; fi
        retry_or_abort "安装脚本 $name" "$required" || return 0
    done
}

notice "$TITLE"
printf '安装顺序：框架 → 全局参数 → 依赖检查 → 扩展和附加脚本。\n'
install_core
configure_globals
notice '[3/5] 检查依赖'
doctor_check
notice '[4/5] 安装配置中的扩展和附加脚本'
config_packages
config_scripts
notice '[5/5] 检查最终环境'
doctor_check
# Capture paths discovered during a dependency retry as well.
write_loaders
if (( WARNINGS )); then
    notice "安装流程结束，共有 $WARNINGS 项提示或跳过，请检查上方输出。"
else
    notice '所选安装步骤已完成。'
fi
printf '当前终端加载：source %q\n' "$LOAD_FILE"
# stdin now belongs to the terminal, so do not parse another command from it.
exit 0
}
