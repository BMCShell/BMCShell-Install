{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bmcshell-install/config.schema.json",
  "title": "BMCShell-Install 配置",
  "description": "生成 Windows x64 BMCShell 发布包的交互式 Bash 安装脚本。相对路径以生成后脚本所在目录为基准。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "framework"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string"},
    "framework": {"$ref": "#/$defs/framework"},
    "globals": {"$ref": "#/$defs/globals"},
    "doctor": {"$ref": "#/$defs/doctor"},
    "packages": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/package"}
    },
    "scripts": {
      "type": "array",
      "default": [],
      "items": {"$ref": "#/$defs/script"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "本地路径，相对生成后脚本目录；可展开 ~、$HOME 或 ${HOME}，不执行 Shell 表达式。"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "if": {"pattern": "://"},
          "then": {"pattern": "^https://[^/?#\\s]+(?:[/?][^#]*)?$"}
        }
      ],
      "description": "本地路径或 HTTPS URL。相对路径以生成后的安装脚本目录为基准。"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "文件 SHA256，64 位十六进制；远程文件必须填写真实校验值。"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$",
      "description": "不含目录或 Shell 表达式的命令名。"
    },
    "commands": {
      "type": "array",
      "items": {"$ref": "#/$defs/command"}
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive", "version"],
      "properties": {
        "archive": {"$ref": "#/$defs/source"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "description": "ZIP 中的框架版本，例如 3.0.0-dev.8。"
        },
        "install_dir": {"$ref": "#/$defs/path", "default": "$HOME/.local/share/BMCShell"},
        "home": {"$ref": "#/$defs/path", "description": "数据根目录，省略时使用 install_dir。"},
        "autoload": {"type": "boolean", "default": true}
      },
      "allOf": [{"$ref": "#/$defs/remoteArchiveDigest"}]
    },
    "remoteArchiveDigest": {
      "if": {
        "properties": {"archive": {"pattern": "^https://"}},
        "required": ["archive"]
      },
      "then": {"required": ["sha256"]}
    },
    "remoteFileDigest": {
      "if": {
        "properties": {"file": {"pattern": "^https://"}},
        "required": ["file"]
      },
      "then": {"required": ["sha256"]}
    },
    "globals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "description": "值按字面保存，不展开变量或执行命令。系统和框架启动控制变量由生成器进一步校验。",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": {
              "anyOf": [
                {"pattern": "^(BASH|BMCSHELL_BRIDGE_)"},
                {"enum": ["PATH", "HOME", "BMCSHELL_HOME", "BMCSHELL_EXE", "BMCSHELL_CONTEXT", "ENV", "IFS", "SHELLOPTS", "CDPATH", "GLOBIGNORE", "PS4", "SHELL", "UID", "EUID", "PPID", "PWD", "OLDPWD", "SHLVL", "FUNCNAME", "DIRSTACK", "GROUPS", "PIPESTATUS", "RANDOM", "SECONDS", "LINENO", "OPTIND", "OPTARG"]},
                {"enum": ["TITLE", "CORE_ARCHIVE", "CORE_SHA256", "CORE_VERSION", "INSTALL_DIR_DEFAULT", "DATA_HOME_DEFAULT", "AUTOLOAD", "DOCTOR_AUTO_REPAIR", "SCAN_ENABLED", "SCAN_COMMANDS", "SCAN_DIRECTORIES", "SCAN_BASE_PATH", "REQUIRED_COMMANDS", "WARNINGS", "SCRIPT_DIR", "WORK_DIR", "REPLY", "FETCH_COUNT", "FETCHED_FILE", "STAGED_CORE", "CHOSEN_PATH", "INSTALL_DIR", "DATA_HOME", "STATE_DIR", "LOAD_FILE", "FOUND_DIRS", "ENV_KEYS", "ENV_VALUES", "CATALOG_READY"]}
              ]
            }
          },
          "additionalProperties": {"type": "string"},
          "default": {}
        },
        "settings": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "description": "通过 bmc setting --set 保存；环境设置键为变量名，不是逻辑字段名。",
          "default": {}
        },
        "scan": {"$ref": "#/$defs/scan"}
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "commands": {
          "$ref": "#/$defs/commands",
          "default": ["curl", "ssh", "ipmitool", "snmpget", "python3", "python"]
        },
        "directories": {
          "type": "array",
          "items": {"$ref": "#/$defs/path"},
          "description": "PATH 之外的扫描候选目录，可用目录 glob。",
          "default": []
        },
        "required": {"$ref": "#/$defs/commands", "default": []}
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_repair": {
          "type": "boolean",
          "default": false,
          "description": "启用 bmc doctor 的交互修复；当前仅支持 Windows x64 MSYS2 自身 pacman。"
        },
        "required_commands": {"$ref": "#/$defs/commands", "default": []}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "file": {"$ref": "#/$defs/source"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "selector": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "default": false},
        "default": {"type": "boolean", "default": true}
      },
      "oneOf": [
        {"required": ["file"], "not": {"required": ["selector"]}},
        {"required": ["selector"], "not": {"anyOf": [{"required": ["file"]}, {"required": ["sha256"]}]}}
      ],
      "allOf": [
        {"$ref": "#/$defs/remoteFileDigest"},
        {"$ref": "#/$defs/requiredStep"}
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "name": {"type": "string"},
        "file": {"$ref": "#/$defs/source"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "args": {"type": "array", "items": {"type": "string"}, "default": []},
        "required": {"type": "boolean", "default": false},
        "default": {"type": "boolean", "default": true}
      },
      "allOf": [
        {"$ref": "#/$defs/remoteFileDigest"},
        {"$ref": "#/$defs/requiredStep"}
      ]
    },
    "requiredStep": {
      "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
      "then": {"properties": {"default": {"const": true}}}
    }
  }
}
