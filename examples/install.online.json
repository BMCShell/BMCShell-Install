{
  "schema": 1,
  "name": "BMCShell 在线交互安装（官方源）",
  "framework": {
    "release_index": "https://github.com/BMCShell/BMCShell/releases/download/release-index/index.json",
    "install_dir": "$HOME/.local/share/BMCShell",
    "home": "$HOME/.local/share/BMCShell-data",
    "autoload": true
  },
  "globals": {
    "env": {
      "BMCSHELL_INSTALL_PROFILE": "online"
    },
    "settings": {
      "BMCSHELL_TLS_MODE": "verify"
    },
    "plugin_sources": {
      "official": {
        "url": "https://raw.githubusercontent.com/BMCShell/packages/main/index.json"
      }
    },
    "scan": {
      "enabled": true,
      "commands": ["curl", "ssh", "ipmitool", "snmpget", "python3", "python"],
      "directories": ["$HOME/bin", "$HOME/.local/bin"],
      "required": []
    }
  },
  "doctor": {
    "auto_repair": false,
    "required_commands": ["curl"]
  },
  "packages": [
    {
      "name": "IPMI 工具（软件源）",
      "selector": "bmcshell-tool-ipmi@1.0.2",
      "required": false,
      "default": false
    }
  ]
}
